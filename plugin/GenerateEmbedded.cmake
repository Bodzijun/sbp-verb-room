# Generates a C++ source that embeds every file under WEB_ROOT (recursively) as bytes plus its relative path.
# Usage: cmake -DWEB_ROOT=<dir> -DOUT_CPP=<file.cpp> -P GenerateEmbedded.cmake
# Files with the extensions .md/.map/.cmake and names starting with '.' are skipped. Paths are stored with '/'.
if(NOT WEB_ROOT OR NOT OUT_CPP)
  message(FATAL_ERROR "GenerateEmbedded.cmake needs -DWEB_ROOT and -DOUT_CPP")
endif()
file(GLOB_RECURSE all_files RELATIVE "${WEB_ROOT}" "${WEB_ROOT}/*")
list(SORT all_files)
set(arrays "")
set(table "")
set(index 0)
foreach(rel IN LISTS all_files)
  get_filename_component(name "${rel}" NAME)
  get_filename_component(ext "${rel}" LAST_EXT)
  if(name MATCHES "^\\." OR ext STREQUAL ".md" OR ext STREQUAL ".map" OR ext STREQUAL ".cmake")
    continue()
  endif()
  if(EXISTS "${WEB_ROOT}/src/app.js" AND NOT (rel STREQUAL "index.html" OR rel MATCHES "^(src|assets|schema)/"))
    continue()
  endif()
  file(READ "${WEB_ROOT}/${rel}" hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")
  if(size EQUAL 0)
    set(bytes "0x00")
  endif()
  string(APPEND arrays "static const unsigned char kFile${index}[] = {\n${bytes}\n};\n")
  string(APPEND table "    { \"${rel}\", kFile${index}, ${size}u },\n")
  math(EXPR index "${index} + 1")
endforeach()
file(WRITE "${OUT_CPP}.tmp"
"// Generated by GenerateEmbedded.cmake from ${WEB_ROOT}. Do not edit.
#include \"WebResources.h\"

namespace verbweb {
namespace {
${arrays}
const EmbeddedFile kEmbeddedFiles[] = {
${table}    { nullptr, nullptr, 0u }
};
}  // namespace

const EmbeddedFile* embeddedFileTable(std::size_t& count) {
    count = ${index}u;
    return kEmbeddedFiles;
}
}  // namespace verbweb
")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT_CPP}.tmp" "${OUT_CPP}")
file(REMOVE "${OUT_CPP}.tmp")
