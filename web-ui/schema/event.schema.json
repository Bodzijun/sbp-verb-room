{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verbroom.invalid/web-ui/schema/event.schema.json",
  "title": "Verb Room WebView contract v1: ack/error/patch and notifications",
  "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/Event",
  "$defs": {
    "Ack": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "revision": {
          "$ref": "https://verbroom.invalid/web-ui/schema/common.schema.json#/$defs/Uint64String"
        },
        "status": {
          "enum": [
            "accepted",
            "noChange"
          ]
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "jobId": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "revision",
        "status"
      ]
    },
    "Error": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "code": {
          "$ref": "https://verbroom.invalid/web-ui/schema/common.schema.json#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "currentRevision": {
          "$ref": "https://verbroom.invalid/web-ui/schema/common.schema.json#/$defs/Uint64String"
        },
        "field": {
          "type": "string"
        },
        "resync": {
          "type": "boolean",
          "description": "true => client MUST discard local state and request/await a snapshot."
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "currentRevision"
      ]
    },
    "Patch": {
      "type": "object",
      "properties": {
        "fromRevision": {
          "$ref": "https://verbroom.invalid/web-ui/schema/common.schema.json#/$defs/Uint64String"
        },
        "toRevision": {
          "$ref": "https://verbroom.invalid/web-ui/schema/common.schema.json#/$defs/Uint64String"
        },
        "originRequestId": {
          "type": "string"
        },
        "ops": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "op": {
                "enum": [
                  "replace",
                  "add",
                  "remove"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "value": {}
            },
            "additionalProperties": false,
            "required": [
              "op",
              "path"
            ]
          },
          "minItems": 1,
          "maxItems": 2048
        }
      },
      "additionalProperties": false,
      "required": [
        "fromRevision",
        "toRevision",
        "ops"
      ]
    },
    "MetersInput": {
      "type": "object",
      "properties": {
        "event": {
          "const": "meters.input"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "hostInputChannels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "peaks": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "seq",
        "hostInputChannels",
        "peaks"
      ]
    },
    "StatusLoad": {
      "type": "object",
      "properties": {
        "event": {
          "const": "status.load"
        },
        "state": {
          "$ref": "https://verbroom.invalid/web-ui/schema/common.schema.json#/$defs/LoadState"
        },
        "status": {
          "type": "string"
        },
        "sceneSerial": {
          "$ref": "https://verbroom.invalid/web-ui/schema/common.schema.json#/$defs/Uint64String"
        },
        "loadSerial": {
          "$ref": "https://verbroom.invalid/web-ui/schema/common.schema.json#/$defs/Uint64String"
        },
        "tailCurrent": {
          "type": "boolean"
        },
        "rebuilding": {
          "type": "boolean",
          "description": "Real requested/applied processor state has differed for at least 150 ms."
        },
        "cpu": {
          "type": "object",
          "properties": {
            "active": {
              "type": "boolean"
            },
            "meanPercent": {
              "type": "number",
              "minimum": 0
            },
            "worstPercent": {
              "type": "number",
              "minimum": 0
            },
            "overruns": {
              "type": "integer",
              "minimum": 0
            },
            "recentOverrun": {
              "type": "boolean"
            },
            "blockSize": {
              "type": "integer",
              "minimum": 1
            },
            "sampleRate": {
              "type": "number",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "active",
            "meanPercent",
            "worstPercent",
            "overruns",
            "recentOverrun",
            "blockSize",
            "sampleRate"
          ]
        },
        "pathBakePercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "pathBake": {
          "$ref": "#/$defs/PathBakeStatus"
        },
        "modulation": {
          "type": "object",
          "properties": {
            "routes": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "raw": { "type": "number" },
                  "value": { "type": "number" },
                  "active": { "type": "boolean" }
                },
                "additionalProperties": false,
                "required": ["raw", "value", "active"]
              }
            }
          },
          "additionalProperties": false,
          "required": ["routes"]
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "state",
        "status",
        "sceneSerial",
        "loadSerial"
      ]
    },
    "StatusExport": {
      "type": "object",
      "properties": {
        "event": {
          "const": "status.export"
        },
        "state": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "state",
        "message"
      ]
    },
    "StatusRt60": {
      "type": "object",
      "properties": {
        "event": {
          "const": "status.rt60"
        },
        "state": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "achievedS": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "requestedS": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "estimate": {
          "type": "object",
          "properties": {
            "low": {
              "type": "number",
              "minimum": 0
            },
            "mid": {
              "type": "number",
              "minimum": 0
            },
            "high": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "low",
            "mid",
            "high"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "state"
      ]
    },
    "DiagnosticsTail": {
      "type": "object",
      "properties": {
        "event": {
          "const": "diagnostics.tail"
        },
        "tailRevision": {
          "$ref": "https://verbroom.invalid/web-ui/schema/common.schema.json#/$defs/Uint64String"
        },
        "durationS": {
          "type": "number",
          "minimum": 0
        },
        "points": {
          "const": 256
        },
        "rt60": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 7,
          "maxItems": 7
        },
        "physicalRT60": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 7,
          "maxItems": 7
        },
        "reliableSeconds": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 7,
          "maxItems": 7
        },
        "active": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 7,
          "maxItems": 7
        },
        "multipliers": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "effectiveMultipliers": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 7,
          "maxItems": 7
        },
        "reshapeStatus": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "minItems": 7,
          "maxItems": 7
        },
        "sourceEffectiveMultipliers": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 7,
            "maxItems": 7
          }
        },
        "sourceReshapeStatus": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "minItems": 7,
            "maxItems": 7
          }
        },
        "decayDb": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 256,
            "maxItems": 256
          },
          "minItems": 7,
          "maxItems": 7
        },
        "physicalDecayDb": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 256,
            "maxItems": 256
          },
          "minItems": 7,
          "maxItems": 7
        },
        "raysUsed": {
          "type": "integer",
          "minimum": 0
        },
        "rayLimit": {
          "type": "integer",
          "minimum": 0
        },
        "baseRays": {
          "type": "integer",
          "minimum": 0
        },
        "shared": {
          "type": "boolean"
        },
        "adaptive": {
          "type": "boolean"
        },
        "needsMoreRays": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "tailRevision",
        "durationS",
        "points",
        "rt60",
        "physicalRT60",
        "reliableSeconds",
        "active",
        "multipliers",
        "effectiveMultipliers",
        "reshapeStatus",
        "decayDb",
        "physicalDecayDb",
        "raysUsed",
        "rayLimit",
        "baseRays",
        "shared",
        "adaptive",
        "needsMoreRays"
      ]
    },
    "AnalysisProgress": {
      "type": "object",
      "properties": {
        "event": {
          "const": "analysis.progress"
        },
        "jobId": {
          "type": "string"
        },
        "state": {
          "enum": [
            "running",
            "cancelling"
          ]
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "jobId",
        "state",
        "progress"
      ]
    },
    "AnalysisResult": {
      "type": "object",
      "properties": {
        "event": {
          "const": "analysis.result"
        },
        "jobId": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "done",
            "cancelled",
            "error"
          ]
        },
        "errorCode": {
          "$ref": "https://verbroom.invalid/web-ui/schema/common.schema.json#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "result": {
          "type": "object",
          "properties": {
            "resultId": {
              "type": "string"
            },
            "sceneRevision": {
              "$ref": "https://verbroom.invalid/web-ui/schema/common.schema.json#/$defs/Uint64String"
            },
            "nx": {
              "type": "integer",
              "minimum": 2,
              "maximum": 96
            },
            "ny": {
              "type": "integer",
              "minimum": 2,
              "maximum": 96
            },
            "x0": {
              "type": "number"
            },
            "y0": {
              "type": "number"
            },
            "dx": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "dy": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "heightM": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 30
            },
            "raysUsed": {
              "type": "integer",
              "minimum": 0
            },
            "options": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "integer",
                  "minimum": -1,
                  "maximum": 31
                },
                "durationS": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 20
                },
                "resolution": {
                  "type": "integer",
                  "minimum": 8,
                  "maximum": 96
                },
                "rays": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 384000
                },
                "components": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                },
                "earlyDb": {
                  "type": "number"
                },
                "tailDb": {
                  "type": "number"
                }
              },
              "additionalProperties": false,
              "required": [
                "source",
                "durationS",
                "resolution",
                "rays",
                "components",
                "earlyDb",
                "tailDb"
              ]
            },
            "validCells": {
              "type": "integer",
              "minimum": 0
            },
            "blob": {
              "type": "object",
              "properties": {
                "layoutVersion": {
                  "const": 1
                },
                "fullUrl": {
                  "type": "string"
                },
                "bandUrlTemplate": {
                  "type": "string"
                },
                "fullByteLength": {
                  "type": "integer",
                  "minimum": 0
                },
                "maskByteLength": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "layoutVersion",
                "fullUrl",
                "bandUrlTemplate",
                "fullByteLength",
                "maskByteLength"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "resultId",
            "sceneRevision",
            "nx",
            "ny",
            "x0",
            "y0",
            "dx",
            "dy",
            "heightM",
            "raysUsed",
            "options",
            "validCells",
            "blob"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "jobId",
        "outcome"
      ]
    },
    "AnalysisStale": {
      "type": "object",
      "properties": {
        "event": {
          "const": "analysis.stale"
        },
        "resultId": {
          "type": "string"
        },
        "stale": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "resultId",
        "stale"
      ]
    },
    "HistoryChanged": {
      "type": "object",
      "properties": {
        "event": {
          "const": "history.changed"
        },
        "canUndo": {
          "type": "boolean"
        },
        "undoDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "canRedo": {
          "type": "boolean"
        },
        "undoLabel": {
          "type": "string",
          "maxLength": 60
        },
        "redoLabel": {
          "type": "string",
          "maxLength": 60
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "canUndo",
        "undoDepth"
      ]
    },
    "HostChanged": {
      "type": "object",
      "properties": {
        "event": {
          "const": "host.changed"
        },
        "inputChannels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "outputChannels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "renderedChannels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "inputChannels",
        "outputChannels",
        "renderedChannels"
      ]
    },
    "ResyncRequired": {
      "type": "object",
      "properties": {
        "event": {
          "const": "resync.required"
        },
        "reason": {
          "enum": [
            "asyncLoad",
            "stateRestored",
            "staleRevision",
            "sequenceGap",
            "undo",
            "structuralChange",
            "redo"
          ]
        },
        "currentRevision": {
          "$ref": "https://verbroom.invalid/web-ui/schema/common.schema.json#/$defs/Uint64String"
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "reason",
        "currentRevision"
      ]
    },
    "Event": {
      "oneOf": [
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/MetersInput"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/StatusLoad"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/StatusExport"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/StatusRt60"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/DiagnosticsTail"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/AnalysisProgress"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/AnalysisResult"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/AnalysisStale"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/HistoryChanged"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/HostChanged"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/ResyncRequired"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/CatalogsList"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/DiagnosticsPaths"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/DiagnosticsClutter"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/StatusFile"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/MetersOutput"
        },
        {
          "$ref": "https://verbroom.invalid/web-ui/schema/event.schema.json#/$defs/AnalysisCleared"
        }
      ]
    },
    "CatalogsList": {
      "type": "object",
      "properties": {
        "event": {
          "const": "catalogs.list"
        },
        "requestId": {
          "type": "string"
        },
        "materials": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "https://verbroom.invalid/web-ui/schema/state.schema.json#/$defs/Material"
          }
        },
        "builtinRooms": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ]
          }
        },
        "userPresets": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "format": {
                "enum": [
                  "txt",
                  "verbroom"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "format"
            ]
          }
        },
        "directivityProfiles": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "attribution": {
                "type": "string"
              },
              "isModel": {
                "type": "boolean"
              },
              "polarSlices": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 72,
                  "maxItems": 72
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "category",
              "license",
              "attribution",
              "isModel"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "materials",
        "builtinRooms",
        "userPresets"
      ]
    },
    "DiagnosticsPaths": {
      "type": "object",
      "properties": {
        "event": {
          "const": "diagnostics.paths"
        },
        "revision": {
          "$ref": "https://verbroom.invalid/web-ui/schema/common.schema.json#/$defs/Uint64String"
        },
        "sceneSerial": {
          "$ref": "https://verbroom.invalid/web-ui/schema/common.schema.json#/$defs/Uint64String"
        },
        "sourceIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "paths": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "sourceIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "receiverIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "order": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "pointsM": {
                "type": "array",
                "minItems": 2,
                "maxItems": 128,
                "items": {
                  "$ref": "https://verbroom.invalid/web-ui/schema/common.schema.json#/$defs/Vec3"
                }
              },
